# SecurVibe — copy to .env.local. Every variable is OPTIONAL.
#
# Golden rule: never prefix a secret with NEXT_PUBLIC_ — variables with this
# prefix are embedded in the browser's JavaScript.

# ------------------------------------------------------------------ GitHub ----
# GitHub token (classic or fine-grained) used server-side ONLY when the user
# does not provide their own in the scan form. Replaces the anonymous quota
# (60 requests/hour) with 5,000 requests/hour. Leave empty for standard usage.
GITHUB_TOKEN=

# ------------------------------------------------------- Shared quota store ----
# Shared Redis store (Upstash REST API) for multi-instance or serverless
# deployments. Not set: quotas fall back to per-instance in-memory counters
# ("fail-open"): the service keeps working with less accuracy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --------------------------------------------------------- AI (OpenRouter) ----
# Optional: enables the "Analyze with AI" review in the audit report. The key
# stays server-side; users never provide keys through the interface.
OPENROUTER_API_KEY=
# Optional: model id used for the review. Default: openai/gpt-4o-mini
OPENROUTER_MODEL=

# ------------------------------------------------------------------- Site ----
# Canonical public https URL: used for canonical/hreflang tags, social
# metadata, and as the OpenRouter HTTP-Referer header.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------- Contact ----
# Contact address shown on the legal page (server-side only).
CONTACT_EMAIL=
