
# ------------------------------------------------------- Shared quota store ----
# Shared Redis store (Upstash REST API) for multi-instance or serverless
# deployments. Not set: quotas fall back to per-instance in-memory counters
# ("fail-open"): the service keeps working with less accuracy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --------------------------------------------------------- AI (OpenRouter) ----
# Optional: enables the "Analyze with AI" review in the audit report. The key
# stays server-side; users never provide keys through the interface.
OPENROUTER_API_KEY=
# Optional: model id used for the review. Default: openai/gpt-4o-mini
OPENROUTER_MODEL=

GITHUB_TOKEN=



# -------------------------------------------------------------- Contact -----
# Adresse de contact affichée sur la page légale (privée côté serveur).
CONTACT_EMAIL=