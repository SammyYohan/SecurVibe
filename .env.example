# — Copier en .env.local — Toutes ces variables sont OPTIONNELLES.
#
# Règle d'or : ne JAMAIS préfixer un secret par NEXT_PUBLIC_ — ces variables sont
# embarquées dans le JavaScript du navigateur.

# ---------------------------------------------------------------- GitHub ----
# Token GitHub (classic ou fine-grained) utilisé côté serveur UNIQUEMENT quand
# l'utilisateur n'en fournit pas lui-même. Remplace le quota anonyme (60/h)
# par 5000 requêtes/h. Laisser vide pour l'usage standard.
GITHUB_TOKEN=

# ---------------------------------------------------------------- Stripe ----
# Payment Links Stripe (https://dashboard.stripe.com/payment-links) par palier.
# Si vide, les boutons de paiement affichent l'accès anticipé (beta) à la place.
STRIPE_LINK_ESSENTIAL=
STRIPE_LINK_PRO=
STRIPE_LINK_TEAM=
STRIPE_LINK_PACK=

# ------------------------------------------------------------------- Site ---
# URL publique (https) canonique : utilisée pour les balises
# canonical/hreflang et les métadonnées sociales.
NEXT_PUBLIC_SITE_URL=

# -------------------------------------------------------------- Contact -----
# Adresse de contact affichée sur la page légale (privée côté serveur).
CONTACT_EMAIL=
